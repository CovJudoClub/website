<script is:inline>
const rv=[...document.querySelectorAll('.rv')];
const show=el=>el.classList.add('in');
rv.forEach((el,i)=>{el.style.transitionDelay=(i%4)*70+'ms';if(el.getBoundingClientRect().top<innerHeight)show(el)});
if('IntersectionObserver'in window){const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){show(e.target);io.unobserve(e.target)}}),{threshold:.12});rv.forEach(el=>io.observe(el))}else rv.forEach(show);
setTimeout(()=>rv.forEach(show),1500);
</script>
