---
const approvalNotice = 'Draft site scaffold — club facts, timetable, prices and payment links still require approval before launch.';
---

<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Draft Coventry Judo Club website rebuild scaffold." />
    <title>Coventry Judo Club</title>
  </head>
  <body>
    <header class="site-header" aria-label="Site header">
      <a class="skip-link" href="#main">Skip to content</a>
      <p class="eyebrow">Coventry Judo Club</p>
      <nav aria-label="Primary navigation">
        <a href="#start">Start judo</a>
        <a href="#classes">Classes</a>
        <a href="#membership">Membership</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div>
          <p class="eyebrow">Family-friendly • disciplined • welcoming</p>
          <h1 id="hero-title">A modern home for Coventry Judo Club is taking shape.</h1>
          <p class="lede">
            This private draft scaffold establishes the Astro + TypeScript foundation for the new club website.
          </p>
          <p class="notice" role="note">{approvalNotice}</p>
          <a class="button" href="#contact">Register interest</a>
        </div>
        <div class="crest-placeholder" aria-label="Coventry Judo Club crest placeholder">
          CJC
        </div>
      </section>

      <section id="start" class="panel" aria-labelledby="start-title">
        <h2 id="start-title">Beginner journey</h2>
        <p>Placeholder content will be replaced only with approved club facts and copy.</p>
      </section>

      <section id="classes" class="panel" aria-labelledby="classes-title">
        <h2 id="classes-title">Classes and timetable</h2>
        <p>Timetable details are intentionally omitted until confirmed by Robert/Bobbie or club officials.</p>
      </section>

      <section id="membership" class="panel" aria-labelledby="membership-title">
        <h2 id="membership-title">Membership and payments</h2>
        <p>Future links will use approved hosted handoffs for Coacha, British Judo and GoCardless/direct debit.</p>
      </section>

      <section id="contact" class="panel" aria-labelledby="contact-title">
        <h2 id="contact-title">Contact</h2>
        <p>Contact form and assistant workflows will be added after privacy, safeguarding and recipient approval.</p>
      </section>
    </main>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
    --crest-red: #b5121b;
    --tatami-cream: #f8f1df;
    --charcoal: #14171a;
    --gi-white: #ffffff;
    --gold: #d7a72f;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--tatami-cream);
    color: var(--charcoal);
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    line-height: 1.6;
  }

  .skip-link {
    position: absolute;
    left: 1rem;
    top: 1rem;
    transform: translateY(-200%);
    background: var(--charcoal);
    color: var(--gi-white);
    padding: 0.75rem 1rem;
    z-index: 10;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .site-header {
    align-items: center;
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    padding: 1rem clamp(1rem, 4vw, 4rem);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
  }

  a {
    color: var(--charcoal);
  }

  a:focus-visible,
  .button:focus-visible {
    outline: 3px solid var(--gold);
    outline-offset: 4px;
  }

  .hero {
    align-items: center;
    display: grid;
    gap: 2rem;
    grid-template-columns: minmax(0, 1fr) minmax(12rem, 20rem);
    min-height: 70vh;
    padding: clamp(2rem, 7vw, 7rem) clamp(1rem, 4vw, 4rem);
  }

  .eyebrow {
    color: var(--crest-red);
    font-size: 0.875rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(2.5rem, 8vw, 6rem);
    line-height: 0.95;
    margin: 0 0 1rem;
    max-width: 12ch;
  }

  h2 {
    font-size: clamp(1.75rem, 4vw, 3rem);
    line-height: 1.1;
    margin-top: 0;
  }

  .lede {
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    max-width: 45rem;
  }

  .notice {
    background: var(--gi-white);
    border-left: 0.35rem solid var(--crest-red);
    max-width: 48rem;
    padding: 1rem;
  }

  .button {
    background: var(--crest-red);
    border-radius: 999px;
    color: var(--gi-white);
    display: inline-block;
    font-weight: 800;
    margin-top: 1rem;
    padding: 0.85rem 1.2rem;
    text-decoration: none;
  }

  .crest-placeholder {
    align-items: center;
    aspect-ratio: 1;
    background:
      radial-gradient(circle at 50% 45%, var(--gi-white) 0 34%, transparent 35%),
      conic-gradient(from -30deg, var(--crest-red), var(--gold), #1f6f43, var(--crest-red));
    border: 0.5rem solid var(--gi-white);
    border-radius: 50%;
    box-shadow: 0 1.5rem 4rem rgb(20 23 26 / 20%);
    color: var(--charcoal);
    display: grid;
    font-size: clamp(2.5rem, 7vw, 5rem);
    font-weight: 900;
    justify-content: center;
    letter-spacing: -0.08em;
  }

  .panel {
    background: var(--gi-white);
    border-top: 1px solid rgb(20 23 26 / 12%);
    padding: clamp(2rem, 6vw, 5rem) clamp(1rem, 4vw, 4rem);
  }

  @media (max-width: 760px) {
    .site-header,
    .hero {
      align-items: start;
      grid-template-columns: 1fr;
    }

    .site-header {
      flex-direction: column;
    }

    .crest-placeholder {
      max-width: 14rem;
    }
  }
</style>
